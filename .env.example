# The canonical URL of the deployed site, used for metadata, sitemap.xml,
# robots.txt, canonical links, and Open Graph tags.
#
# Set this in your Vercel project's Environment Variables once you connect
# your custom domain, e.g.:
#   NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
#
# Leave unset locally — it falls back to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=
